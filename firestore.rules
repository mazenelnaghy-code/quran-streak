rules_version = '2';

// Noor keeps each circle of friends under circles/{circleId}. Circles can't be listed, so the long random
// id in the invite link is what lets someone in. Anyone with the link can read the circle and join it.
service cloud.firestore {
  match /databases/{database}/documents {
    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 24;
    }

    match /circles/{circleId} {
      allow get: if circleId.size() >= 16;
      allow list: if false;
      allow create: if circleId.size() >= 16 && circleId.size() <= 40
        && request.resource.data.keys().hasOnly(['by', 'createdAt'])
        && validName(request.resource.data.by)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      match /members/{memberId} {
        function validMember() {
          let d = request.resource.data;
          return memberId.size() >= 8 && memberId.size() <= 40
            && d.keys().hasOnly(['name', 'color', 'joinedAt', 'days'])
            && d.keys().hasAll(['name', 'color', 'joinedAt', 'days'])
            && validName(d.name)
            && d.color is string && d.color.size() <= 16
            && d.joinedAt is timestamp
            && d.days is map && d.days.size() <= 5000;
        }

        allow read: if circleId.size() >= 16;
        allow create: if existsAfter(/databases/$(database)/documents/circles/$(circleId)) && validMember();
        allow update: if validMember() && request.resource.data.joinedAt == resource.data.joinedAt;
        allow delete: if false;
      }
    }
  }
}
